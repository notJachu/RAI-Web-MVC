@model IEnumerable<TransitDesk.Web.Models.VehicleViewModel>

@{
    ViewData["Title"] = "Monitorowane pojazdy";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Monitorowane pojazdy (Sesja)</h2>
    <a asp-controller="Vehicles" asp-action="GetVehicleList" asp-route-zaj="NowyPort" class="btn btn-outline-secondary">Wszystkie pojazdy</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Nr boczny</th>
                <th>Model</th>
                <th>Zajezdnia</th>
                <th>Rok prod.</th>
                <th>Pojemność</th>
                <th>Niskopodłogowy</th>
                <th>Status</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vehicle in Model)
            {
                <tr>
                    <td>@vehicle.SideNumber</td>
                    <td>@vehicle.ModelName</td>
                    <td>@vehicle.DepotName</td>
                    <td>@vehicle.ProductionYear</td>
                    <td>@vehicle.Capacity</td>
                    <td>@(vehicle.IsLowFloor ? "Tak" : "Nie")</td>
                    <td>@vehicle.ServiceStatus</td>
                    <td class="text-nowrap">
                        <a asp-controller="Vehicles" asp-action="GetVehicle" asp-route-number="@vehicle.SideNumber" class="btn btn-sm btn-outline-primary">Szczegóły</a>
                        <form asp-controller="Vehicles" asp-action="RemoveVehicleFromWatchlist" asp-route-sideNumber="@vehicle.SideNumber" method="post" class="d-inline">
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Usuń z listy</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">Brak monitorowanych pojazdów w bieżącej sesji.</div>
}
